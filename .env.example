# Tailscale Auth Key
# Generate at https://login.tailscale.com/admin/settings/keys
# Check "Reusable" and "Ephemeral" when creating the key.
TS_AUTHKEY=tskey-auth-YOUR_KEY_HERE

# ── VIP / Serve overrides (optional) ─────────────────────────────────────────
# Defaults match the standard single-stack setup. Uncomment only if needed.
#
#APP_HEALTH_URL=http://nginx:80/health     # health endpoint the sidecar polls
#VIP_SERVICE=svc:jarvis                   # Tailscale VIP service name
#VIP_BACKEND=http://nginx:80              # backend address advertised to VIP
#VIP_MODE=http                            # "http" (dual-port) or "https"
#OLLAMA_SERVE_URL=http://ollama:11434     # Ollama API endpoint served on Tailnet port 11434

# ── AMD ROCm override (optional) ─────────────────────────────────────────────
# Required for RDNA 4 (gfx1200). Remove or adjust for other AMD GPU generations.
#HSA_OVERRIDE_GFX_VERSION=12.0.0
