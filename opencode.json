{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "github-copilot",
    "openai",
    "google-vertex-ai",
    "ollama"
  ],
  "model": "openai/gpt-4o",
  "small_model": "openai/gpt-4o-mini",
  "provider": {
    "openai": {
      "options": {
        "timeout": 600000
      }
    },
    "google-vertex-ai": {
      "options": {
        "timeout": 600000
      }
    },
    "github-copilot": {
      "options": {
        "timeout": 600000
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://jarvis-beta.tailcd013.ts.net:11435/v1"
      },
      "models": {
        "llama3.1:latest": {
          "name": "Llama 3.1 8B (local)"
        }
      }
    }
  },
  "autoupdate": true,
  "share": "manual",
  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "read": true,
    "glob": true,
    "grep": true
  },
}