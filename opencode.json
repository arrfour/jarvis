{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["github-copilot", "openai", "google-vertex-ai"],
  "model": "openai/gpt-4o",
  "small_model": "openai/gpt-4o-mini",
  "provider": {
    "openai": {
      "options": {
        "timeout": 600000
      }
    },
    "google-vertex-ai": {
      "options": {
        "timeout": 600000
      }
    },
    "github-copilot": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "autoupdate": true,
  "share": "manual",
  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "read": true,
    "glob": true,
    "grep": true
  },
  "permissions": {
    "bash": "ask",
    "edit": "allow",
    "write": "allow"
  }
}