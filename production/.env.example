# Tailscale Auth Key
# Generate at https://login.tailscale.com/admin/settings/keys
# Check "Reusable" and "Ephemeral"
TS_AUTHKEY=tskey-api-YOUR_KEY_HERE

# VIP Registrar — host Tailscale integration
# The vip-registrar sidecar connects to the host's tailscaled daemon to register
# this machine as a backend for the svc:jarvis VIP. Adjust if your Tailscale
# installation uses non-standard paths (e.g., /usr/local/bin/tailscale on macOS).
# Requires native Tailscale on the host with tag:services on the tailnet.
TAILSCALE_BIN=/usr/bin/tailscale
TAILSCALE_SOCK=/var/run/tailscale/tailscaled.sock
