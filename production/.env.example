# Tailscale Auth Key
# Generate at https://login.tailscale.com/admin/settings/keys
# Check "Reusable" and "Ephemeral"
TS_AUTHKEY=tskey-api-YOUR_KEY_HERE

# VIP Registration (optional overrides — defaults match standard svc:jarvis setup)
# Uncomment and adjust only if your setup differs from the defaults.
#APP_HEALTH_URL=http://localhost:8080/health   # app health endpoint (host network)
#VIP_SERVICE=svc:jarvis                        # Tailscale VIP service name
#VIP_BACKEND=https://localhost:443             # backend address to advertise
